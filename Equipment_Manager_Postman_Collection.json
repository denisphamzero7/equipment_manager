{
    "info": {
        "_postman_id": "equipment-manager-module-6ad7400bb5d43",
        "name": "Quản lý Trang thiết bị (Equipment)",
        "description": "Bộ sưu tập đầy đủ các API Quản lý Trang thiết bị (Equipment Management):\n- Sơ đồ mặt bằng (Hotel Map View)\n- Chi tiết thiết bị phòng & đối soát định mức\n- CRUD & lọc danh sách thiết bị\n- Điều chuyển phòng, báo hỏng, đổi trạng thái\n- Thống kê, xuất/nhập Excel",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "1. Sơ đồ Khách sạn (Hotel Map View)",
            "description": "Các API phục vụ vẽ sơ đồ mặt bằng các Block, Tầng và trạng thái cảnh báo của từng phòng.",
            "item": [
                {
                    "name": "1.1 Danh sách Block / Khu vực",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "X-Organization-Id",
                                "value": "22",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{url}}/equipments/map-view/blocks",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "equipments",
                                "map-view",
                                "blocks"
                            ]
                        },
                        "description": "Lấy danh sách các Block/Khu vực hiện có để hiển thị bộ lọc sơ đồ mặt bằng."
                    }
                },
                {
                    "name": "1.2 Danh sách Tầng (Floors)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "X-Organization-Id",
                                "value": "22",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{url}}/equipments/map-view/floors?block=",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "equipments",
                                "map-view",
                                "floors"
                            ],
                            "query": [
                                {
                                    "key": "block",
                                    "value": "",
                                    "description": "Lọc theo Block (tùy chọn)",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Lấy danh sách các tầng trong khách sạn (có thể lọc theo Block)."
                    }
                },
                {
                    "name": "1.3 Dữ liệu Sơ đồ Mặt bằng (Map View Grid)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "X-Organization-Id",
                                "value": "22",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{url}}/equipments/map-view?block=&floor=",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "equipments",
                                "map-view"
                            ],
                            "query": [
                                {
                                    "key": "block",
                                    "value": "",
                                    "description": "Tên block (tùy chọn)",
                                    "disabled": true
                                },
                                {
                                    "key": "floor",
                                    "value": "",
                                    "description": "Số tầng (tùy chọn)",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Lấy danh sách các phòng kèm tọa độ grid, số lượng thiết bị, và trạng thái màu sắc cảnh báo (xanh: đủ tốt, vàng: bảo trì, đỏ: hỏng/thiếu)."
                    }
                }
            ]
        },
        {
