                                "value": "22",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{url}}/equipments/rooms/1",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "equipments",
                                "rooms",
                                "1"
                            ]
